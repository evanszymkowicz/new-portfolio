{
  "name": "evan-portfolio-2025",
  "version": "1.0.0",
  "scripts": {
    "dev": "gatsby develop",
    "build": "gatsby build",
    "build:production": "gatsby build --prefix-paths",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "type-check": "tsc --noEmit",
    "lint": "eslint './src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint './src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write './src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "npm run build && lhci autorun",
    "lighthouse:report": "node scripts/lighthouse-report.js"
  },
  "dependencies": {
    "babel-plugin-styled-components": "^2.1.4",
    "gatsby": "^5.13.0",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-offline": "^6.15.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-plugin-styled-components": "^6.15.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-json": "^5.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "jsdom": "^27.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-responsive-carousel": "^3.2.23",
    "schema-dts": "^1.1.5",
    "styled-components": "^6.1.19",
    "styled-reset": "^5.0.0"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not IE 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "ajv": "^8.17.1",
    "babel-jest": "^30.2.0",
    "babel-preset-gatsby": "^3.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
